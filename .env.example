APP_ENV=prod
APP_LOG_LEVEL=info
FLOWBIZ_SERVICE_NAME=flowbiz-template-service
FLOWBIZ_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg2://flowbiz:flowbiz@postgres:5432/flowbiz

JWT_SECRET_KEY=generate-a-secure-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=set-a-strong-password-here
PII_HASH_PEPPER=generate-a-random-pepper-here

POSTGRES_DB=flowbiz
POSTGRES_USER=flowbiz
POSTGRES_PASSWORD=flowbiz

VPS_API_PORT=8001
OTEL_ENABLED=false
